# ===================================================================
# Smart Internship Tracker - Environment Variables Template
# Copy this file to .env or export these in your deployment environment
# ===================================================================

# Server Port
PORT=8080

# JWT Security (Required: minimum 256-bit secret key for HMAC-SHA256)
JWT_SECRET=ReplaceWithYourSecureSecretKeyThatIsAtLeast32Characters2026!
JWT_EXPIRATION_MS=86400000

# Initial Admin Account (Seeded on startup)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Placement Administrator

# MySQL Database Configuration (Required only when using -Dspring-boot.run.profiles=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=internship_tracker
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
